+/** AOT path queue replacing the private reference-array interface. */
+function _wp_aot_flatten_block_paths( mixed $blocks ): mixed {
+    $queue = array();
+    foreach ( array_keys( $blocks ) as $key ) {
+        $queue[] = array( $key );
+    }
+    $paths = array();
+    while ( \wp_aot_count( $queue ) > 0 ) {
+        $path = \wp_aot_array_shift( $queue );
+        $paths[] = $path;
+        $block = _wp_array_get( $blocks, $path );
+        if ( ! empty( $block['innerBlocks'] ) ) {
+            foreach ( array_keys( $block['innerBlocks'] ) as $key ) {
+                $child_path = $path;
+                $child_path[] = 'innerBlocks';
+                $child_path[] = $key;
+                $queue[] = $child_path;
+            }
+        }
+    }
+    return $paths;
+	return null;
+}
