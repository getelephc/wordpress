const WP_AOT_NATIVE_RUNTIME = true;

function wp_aot_object_id(object $value): int {
    return spl_object_id($value);
}

require_once __DIR__ . '/aot-binary.php';
require_once __DIR__ . '/aot-arrays.php';
require_once __DIR__ . '/aot-query.php';

// Record successful executed definitions without replacing the actual native constants.
$wp_aot_bootstrap_definitions = wp_aot_empty_request_array();
function wp_aot_bootstrap_defined(string $name): bool {
    if (!wp_aot_bootstrap_known_constant($name)) throw new LogicException('Unknown bootstrap constant.');
    global $wp_aot_bootstrap_definitions;
    return array_key_exists($name, $wp_aot_bootstrap_definitions);
}
function wp_aot_bootstrap_mark(string $name, bool $success): bool {
    if (!wp_aot_bootstrap_known_constant($name)) throw new LogicException('Unknown bootstrap constant.');
    if ($success) {
        global $wp_aot_bootstrap_definitions;
        $wp_aot_bootstrap_definitions[$name] = true;
    }
    return $success;
}

$wp_aot_bootstrap_strings = wp_aot_empty_request_map();
function wp_aot_bootstrap_capture_string(string $name, string $value): string {
    if (!wp_aot_bootstrap_string_known($name)) throw new LogicException('Unknown bootstrap string constant.');
    global $wp_aot_bootstrap_strings;
    if (!array_key_exists($name, $wp_aot_bootstrap_strings)) $wp_aot_bootstrap_strings[$name] = $value;
    return $value;
}
function wp_aot_bootstrap_string(string $name): string {
    if (!wp_aot_bootstrap_string_known($name)) throw new LogicException('Unknown bootstrap string constant.');
    global $wp_aot_bootstrap_strings;
    if (!array_key_exists($name, $wp_aot_bootstrap_strings)) throw new Error('Undefined constant "' . $name . '"');
    return (string) $wp_aot_bootstrap_strings[$name];
}

$wp_aot_subdomain_values = wp_aot_empty_request_array();
$wp_aot_pclzip_values = wp_aot_empty_request_array();

// Preserve the executed definition of the one conditional ZIP block-size constant.
function wp_aot_pclzip_block_size_defined(): bool {
    global $wp_aot_pclzip_values;
    return array_key_exists('PCLZIP_READ_BLOCK_SIZE', $wp_aot_pclzip_values);
}
function wp_aot_pclzip_block_size_define(mixed $value): bool {
    if (wp_aot_pclzip_block_size_defined()) throw new LogicException('Duplicate ZIP block-size definitions are outside this fixture.');
    global $wp_aot_pclzip_values;
    $wp_aot_pclzip_values['PCLZIP_READ_BLOCK_SIZE'] = $value;
    return true;
}
function wp_aot_pclzip_block_size(): mixed {
    if (!wp_aot_pclzip_block_size_defined()) throw new Error('Undefined constant "PCLZIP_READ_BLOCK_SIZE"');
    global $wp_aot_pclzip_values;
    return $wp_aot_pclzip_values['PCLZIP_READ_BLOCK_SIZE'];
}

// Only the two mutually defined Multisite aliases use this request-local inventory.
function wp_aot_subdomain_defined(string $name): bool {
    if ($name !== 'VHOST' && $name !== 'SUBDOMAIN_INSTALL') throw new LogicException('Unknown Multisite alias.');
    global $wp_aot_subdomain_values;
    if (array_key_exists($name, $wp_aot_subdomain_values)) return true;
    return array_key_exists($name, get_defined_constants());
}
function wp_aot_subdomain_constant(string $name): mixed {
    if ($name !== 'VHOST' && $name !== 'SUBDOMAIN_INSTALL') throw new LogicException('Unknown Multisite alias.');
    global $wp_aot_subdomain_values;
    if (array_key_exists($name, $wp_aot_subdomain_values)) return $wp_aot_subdomain_values[$name];
    return wp_aot_metadata_constant($name);
}
function wp_aot_subdomain_define(string $name, mixed $value): bool {
    if (wp_aot_subdomain_defined($name)) throw new LogicException('Duplicate Multisite alias definitions are outside this fixture.');
    global $wp_aot_subdomain_values;
    $wp_aot_subdomain_values[$name] = $value;
    return true;
}

// Native primitives missing from the SDK, supplied through public C ABIs.
extern "System" {
    function sodium_init(): i32;
    function malloc(u64 $size): ptr;
    function free(ptr $memory): void;
    function crypto_generichash(ptr $output, u64 $size, string $message, u64 $length, string $key, u64 $key_length): i32;
    function crypto_box_easy(ptr $output, string $message, u64 $length, string $nonce, string $public_key, string $secret_key): i32;
    function crypto_sign_verify_detached(string $signature, string $message, u64 $length, string $public_key): i32;
}

if (sodium_init() < 0) throw new RuntimeException('Native Sodium initialization failed.');

class SodiumException extends Exception {}

const SODIUM_BASE64_VARIANT_ORIGINAL = 1;
const SODIUM_BASE64_VARIANT_ORIGINAL_NO_PADDING = 3;
const SODIUM_BASE64_VARIANT_URLSAFE = 5;
const SODIUM_BASE64_VARIANT_URLSAFE_NO_PADDING = 7;

function sodium_crypto_generichash(string $message, string $key = '', int $length = 32): string {
    if ($length < 16 || $length > 64 || (strlen($key) !== 0 && (strlen($key) < 16 || strlen($key) > 64))) {
        throw new SodiumException('Invalid generic hash length or key length.');
    }
    $memory = malloc($length);
    if (ptr_is_null($memory)) throw new RuntimeException('Native hash allocation failed.');
    try {
        if (crypto_generichash($memory, $length, $message, strlen($message), $key, strlen($key)) !== 0) {
            throw new SodiumException('Native generic hash failed.');
        }
        return ptr_read_string($memory, (int) $length);
    } finally {
        free($memory);
    }
}

function sodium_crypto_box(string $message, string $nonce, string $key_pair): string {
    if (strlen($nonce) !== 24 || strlen($key_pair) !== 64) {
        throw new SodiumException('Invalid box nonce or key pair length.');
    }
    $length = strlen($message) + 16;
    $memory = malloc($length);
    if (ptr_is_null($memory)) throw new RuntimeException('Native box allocation failed.');
    try {
        if (crypto_box_easy($memory, $message, strlen($message), $nonce, substr($key_pair, 32, 32), substr($key_pair, 0, 32)) !== 0) {
            throw new SodiumException('Native box operation failed.');
        }
        return ptr_read_string($memory, (int) $length);
    } finally {
        free($memory);
    }
}

function sodium_crypto_sign_verify_detached(string $signature, string $message, string $key): bool {
    if (strlen($signature) !== 64 || strlen($key) !== 32) {
        throw new SodiumException('Invalid signature or public key length.');
    }
    return crypto_sign_verify_detached($signature, $message, strlen($message), $key) === 0;
}

function sodium_bin2base64(string $bytes, int $variant): string {
    if ($variant !== 1 && $variant !== 3 && $variant !== 5 && $variant !== 7) {
        throw new SodiumException('Invalid base64 variant.');
    }
    $encoded = base64_encode($bytes);
    if ($variant === 5 || $variant === 7) $encoded = strtr($encoded, '+/', '-_');
    if ($variant === 3 || $variant === 7) $encoded = rtrim($encoded, '=');
    return $encoded;
}

// PHP masks are binary strings. libc strspn stops at NUL and cannot implement this.
function strspn(string $string, string $characters, int $offset = 0, ?int $length = null): int {
    $size = strlen($string);
    $start = $offset < 0 ? max(0, $size + $offset) : min($size, $offset);
    $end = $length === null ? $size : ($length < 0 ? max($start, $size + $length) : min($size, $start + $length));
    $allowed = array_fill(0, 256, false);
    for ($i = 0; $i < strlen($characters); ++$i) $allowed[ord($characters[$i])] = true;
    $at = $start;
    while ($at < $end && $allowed[ord($string[$at])]) ++$at;
    return $at - $start;
}

// PHP version ordering, following php-src/ext/standard/versioning.c.
function aot_version_digit(string $byte): bool {
    if ($byte === '') return false;
    $code = ord($byte);
    return $code >= 48 && $code <= 57;
}

function aot_version_parts(string $version): array {
    if ($version === '' || $version[0] === '#') return explode('.', $version);
    $normalized = $version[0];
    $previous = $version[0];
    for ($i = 1; $i < strlen($version); ++$i) {
        $byte = $version[$i];
        $last = $normalized[strlen($normalized) - 1];
        $code = ord($byte);
        $digit = aot_version_digit($byte);
        $previous_digit = aot_version_digit($previous);
        if ($byte === '-' || $byte === '_' || $byte === '+') {
            if ($last !== '.') $normalized .= '.';
        } elseif (($previous !== '.' && !$previous_digit && $digit) || ($previous_digit && !$digit && $byte !== '.')) {
            if ($last !== '.') $normalized .= '.';
            $normalized .= $byte;
        } elseif (!$digit && !($code >= 65 && $code <= 90) && !($code >= 97 && $code <= 122)) {
            if ($last !== '.') $normalized .= '.';
        } else {
            $normalized .= $byte;
        }
        $previous = $byte;
    }
    if ($normalized[strlen($normalized) - 1] === '.') $normalized = substr($normalized, 0, -1);
    return explode('.', $normalized);
}

function aot_version_order(string $part): int {
    $forms = array('dev', 'alpha', 'a', 'beta', 'b', 'RC', 'rc', '#', 'pl', 'p');
    $orders = array(0, 1, 1, 2, 2, 3, 3, 4, 5, 5);
    foreach ($forms as $index => $form) {
        if (str_starts_with($part, $form)) return (int) $orders[$index];
    }
    return -1;
}

function aot_version_compare(string $first, string $second): int {
    if ($first === '' || $second === '') return ($first !== '') <=> ($second !== '');
    $left = aot_version_parts($first);
    $right = aot_version_parts($second);
    if ((count($left) === 1 && $left[0] === '') || (count($right) === 1 && $right[0] === '')) {
        $remaining = implode('.', $left);
        if ($remaining !== '' && aot_version_digit($remaining[0])) return 1;
        return aot_version_compare($remaining, '#N#');
    }
    $at = 0;
    while ($at < count($left) && $at < count($right)) {
        $a = (string) $left[$at];
        $b = (string) $right[$at];
        $a_digit = aot_version_digit($a === '' ? '' : $a[0]);
        $b_digit = aot_version_digit($b === '' ? '' : $b[0]);
        if ($a_digit && $b_digit) {
            $result = ((int) $a) <=> ((int) $b);
        } else {
            $result = aot_version_order($a_digit ? '#N#' : $a) <=> aot_version_order($b_digit ? '#N#' : $b);
        }
        if ($result !== 0) return $result;
        ++$at;
    }
    if ($at < count($left)) {
        $remaining = (string) $left[$at];
        if ($remaining !== '' && aot_version_digit($remaining[0])) return 1;
        return aot_version_compare(implode('.', array_slice($left, $at)), '#N#');
    }
    if ($at < count($right)) {
        $remaining = (string) $right[$at];
        if ($remaining !== '' && aot_version_digit($remaining[0])) return -1;
        return aot_version_compare('#N#', implode('.', array_slice($right, $at)));
    }
    return 0;
}

function version_compare(string $first, string $second, ?string $operator = null): int|bool {
    foreach (array($first, $second) as $value) {
        for ($i = 0; $i < strlen($value); ++$i) {
            if (ord($value[$i]) === 0) throw new ValueError('Version strings must not contain NUL.');
        }
    }
    $result = aot_version_compare($first, $second);
    if ($operator === null) return $result;
    if ($operator === '<' || $operator === 'lt') return $result < 0;
    if ($operator === '<=' || $operator === 'le') return $result <= 0;
    if ($operator === '>' || $operator === 'gt') return $result > 0;
    if ($operator === '>=' || $operator === 'ge') return $result >= 0;
    if ($operator === '==' || $operator === '=' || $operator === 'eq') return $result === 0;
    if ($operator === '!=' || $operator === '<>' || $operator === 'ne') return $result !== 0;
    throw new ValueError('Invalid version comparison operator.');
}

function preg_quote(string $str, ?string $delimiter = null): string {
    $specials = '\\.+*?[^]$(){}=!<>|:-#';
    $delimiter_byte = substr($delimiter ?? '', 0, 1);
    $result = '';
    for ($index = 0; $index < strlen($str); ++$index) {
        $byte = substr($str, $index, 1);
        if (ord($byte) === 0) {
            $result .= '\\000';
        } else {
            if (str_contains($specials, $byte) || $byte === $delimiter_byte) $result .= '\\';
            $result .= $byte;
        }
    }
    return $result;
}

const FILTER_VALIDATE_URL = 273;
const FILTER_VALIDATE_BOOLEAN = 258;
const SEEK_SET = 0;
const SEEK_CUR = 1;
const SEEK_END = 2;
const PHP_QUERY_RFC1738 = 1;
const PHP_QUERY_RFC3986 = 2;

// Native diagnostics replace PHP's warning buffer in this profile.
function error_get_last(): ?array {
    throw new LogicException('PHP warning-buffer inspection is outside the native profile.');
}
function move_uploaded_file(string $from, string $to): bool {
    throw new LogicException('HTTP upload transport is outside the native profile.');
}
function parse_str(string $string, mixed &$result): void {
    $result = wp_aot_parse_query($string);
}
function filter_var(mixed $value, int $filter = 516, mixed $options = 0): mixed {
    if ($filter === FILTER_VALIDATE_BOOLEAN && $options === 0) {
        if ($value === true || $value === 1 || $value === 1.0) return true;
        if (!is_string($value)) return false;
        $text = strtolower(trim((string) $value, " \t\r\n\v\f"));
        return $text === '1' || $text === 'true' || $text === 'on' || $text === 'yes';
    }
    throw new LogicException('This filter is outside the native profile.');
}
function aot_http_query_pairs(array $data, string $prefix, string $numeric_prefix, int $encoding, int $depth, string $literal_prefix = ''): array {
    if ($depth > 64) throw new ValueError('Query nesting exceeds the native profile.');
    $pairs = array();
    foreach ($data as $key => $value) {
        if ($value === null) continue;
        $name = (string) $key;
        $literal = $depth === 0 ? (is_int($key) ? $numeric_prefix : '') : $literal_prefix;
        if ($depth !== 0) {
            $name = $prefix . '[' . $name . ']';
        }
        if (is_array($value)) {
            foreach (aot_http_query_pairs((array) $value, $name, '', $encoding, $depth + 1, $literal) as $pair) $pairs[] = $pair;
            continue;
        }
        if (is_object($value) || is_resource($value)) throw new LogicException('Only scalar and array query values are supported.');
        $text = is_bool($value) ? ($value ? '1' : '0') : (string) $value;
        if ($encoding === PHP_QUERY_RFC3986) {
            $pairs[] = $literal . rawurlencode($name) . '=' . rawurlencode($text);
        } else {
            $pairs[] = $literal . urlencode($name) . '=' . urlencode($text);
        }
    }
    return $pairs;
}
function http_build_query(mixed $data, string $numeric_prefix = '', ?string $arg_separator = null, int $encoding_type = PHP_QUERY_RFC1738): string {
    if (!is_array($data)) throw new LogicException('Only array query roots are supported.');
    if ($encoding_type !== PHP_QUERY_RFC1738 && $encoding_type !== PHP_QUERY_RFC3986) throw new ValueError('Unsupported query encoding.');
    $joined = '';
    $separator = $arg_separator ?? '&';
    $first = true;
    foreach (aot_http_query_pairs((array) $data, '', $numeric_prefix, $encoding_type, 0) as $pair) {
        if (!$first) $joined .= $separator;
        $joined .= (string) $pair;
        $first = false;
    }
    return $joined;
}


function wp_aot_natural_compare(string $left, string $right): int {
    if ($left === $right) return 0;
    // Two stable orders distinguish equality using the SDK's natural key comparator.
    $forward = array($left => true, $right => false);
    ksort($forward, SORT_NATURAL | SORT_FLAG_CASE);
    foreach ($forward as $left_first) {
        if (!$left_first) return 1;
        break;
    }
    $backward = array($right => false, $left => true);
    ksort($backward, SORT_NATURAL | SORT_FLAG_CASE);
    foreach ($backward as $left_first) {
        if ($left_first) return -1;
        break;
    }
    return 0;
}

function wp_aot_find_character(string $string, string $characters): string|false {
    if ($characters === '') throw new ValueError('strpbrk(): Argument #2 ($characters) must be a non-empty string');
    $allowed = array_fill(0, 256, false);
    for ($i = 0; $i < strlen($characters); ++$i) $allowed[ord($characters[$i])] = true;
    for ($i = 0; $i < strlen($string); ++$i) {
        if ($allowed[ord($string[$i])]) return substr($string, $i);
    }
    return false;
}

function strnatcasecmp(mixed $left, mixed $right): int {
    if (is_int($left)) $left = (string)$left;
    if (is_int($right)) $right = (string)$right;
    if (!is_string($left) || !is_string($right)) throw new TypeError('Natural comparison requires string values.');
    return wp_aot_natural_compare((string) $left, (string) $right);
}
function strpbrk(mixed $string, mixed $characters): string|false {
    if (!is_string($string) || !is_string($characters)) throw new TypeError('Character search requires string values.');
    return wp_aot_find_character((string) $string, (string) $characters);
}

